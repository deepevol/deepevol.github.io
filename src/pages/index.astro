---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Deep Evolution Systems',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Découvrir nos solutions',
        href: '#features',
        icon: 'tabler:arrow-right',
      },
      { text: 'Nous contacter', href: '#contact' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'Deep Evolution Systems Hero Image' }}
  >
    <Fragment slot="title">
      Architectures Systèmes & <br />
      <span class="text-accent dark:text-white highlight">Solutions ERP Avancées</span>
    </Fragment>

    <Fragment slot="subtitle">
      Deep Evolution Systems propulse la transformation numérique de votre industrie. Nous concevons des environnements de gestion sur mesure, de l'intégration de frameworks robustes à l'automatisation complète et localisée de vos flux de données.
    </Fragment>
  </Hero>
  <!-- Note Widget ******************* -->

  <Note title="Philosophy:" description="Simplicity, Best Practices and High Performance" />

  <!-- Features Widget *************** -->

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="Nos Services"
    title="L'expertise Deep Evolution Systems"
    subtitle="Nous concevons, déployons et automatisons les infrastructures logicielles de votre industrie pour maximiser votre productivité."
    items={[
      {
        title: "Intégration d'Écosystèmes ERP",
        description:
          "Déploiement, configuration et personnalisation de systèmes ERP complexes. Nous adaptons les espaces de travail, les flux de validation et les permissions pour correspondre exactement à la hiérarchie et aux besoins de votre entreprise.",
        icon: 'tabler:server-cog',
      },
      {
        title: "Automatisation Python & Intégration",
        description:
          "Développement d'outils d'injection de données sur mesure. Nous automatisons l'importation massive et séquentielle de vos données (entreprises, articles, nomenclatures/BOMs) avec des scripts sécurisés pour garantir l'intégrité de vos bases.",
        icon: 'tabler:code',
      },
      {
        title: "Gestion de Production (GPAO) & Stocks",
        description:
          "Optimisation des flux de fabrication industriels. Nous configurons des environnements dédiés pour vos opérateurs, en nous concentrant sur les modules de production, le suivi précis des nomenclatures et la traçabilité des stocks.",
        icon: 'tabler:building-factory-2',
      },
      {
        title: "Infrastructures Docker & Hébergement",
        description:
          "Administration système et gestion d'environnements conteneurisés. Nous assurons un déploiement fiable et sécurisé de vos applications d'entreprise via Docker, facilitant la maintenance, les sauvegardes et la scalabilité.",
        icon: 'tabler:brand-docker',
      },
    ]}
  />
  
  

</Layout>
